<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Pane?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.presentation.controller.MainViewController"
            stylesheets="@styles.css"
            prefHeight="700.0" prefWidth="1000.0">

    <!-- ============ TOP BAR: general tree management (CRUD) ============ -->
    <top>
        <HBox fx:id="topBar" spacing="10.0" styleClass="top-bar">
            <Label text="Árbol activo:" />
            <ComboBox fx:id="comboTrees" prefWidth="180.0" onAction="#onSelectTree" />

            <Button fx:id="btnNewTree" text="Crear árbol" onAction="#onCreateTree" styleClass="button-primary" />
            <Button fx:id="btnLoadTree" text="Cargar árbol" onAction="#onLoadTree" />
            <Button fx:id="btnSaveTree" text="Guardar árbol" onAction="#onSaveTree" />
            <Button fx:id="btnDeleteTree" text="Eliminar árbol" onAction="#onDeleteTree" styleClass="button-danger" />

            <Separator orientation="VERTICAL" />

        </HBox>
    </top>

    <!-- ============ LEFT PANEL: operations on the selected tree ============ -->
    <left>
        <VBox fx:id="operationsPanel" spacing="12.0" prefWidth="240.0" styleClass="side-panel">
            <Label text="Operaciones" styleClass="section-title" />
            <TextField fx:id="valueField" promptText="Valor entero" />

            <VBox spacing="6.0">
                <Button fx:id="btnInsert" text="Insertar" onAction="#onInsert" styleClass="button-primary" maxWidth="Infinity" />
                <Button fx:id="btnSearch" text="Buscar" onAction="#onSearch" maxWidth="Infinity" />
                <Button fx:id="btnDeleteValue" text="Eliminar" onAction="#onDeleteValue" styleClass="button-danger" maxWidth="Infinity" />
            </VBox>

            <Separator />

            <Label text="Recorridos" styleClass="section-title" />
            <VBox spacing="6.0">
                <Button fx:id="btnPreorder" text="Preorden" onAction="#onPreorder" maxWidth="Infinity" />
                <Button fx:id="btnInorder" text="Inorden" onAction="#onInorder" maxWidth="Infinity" />
                <Button fx:id="btnPostorder" text="Postorden" onAction="#onPostorder" maxWidth="Infinity" />
            </VBox>

            <Separator />

            <!-- Extension point: any future operation can be added here -->
            <Label text="Otras operaciones" styleClass="section-title" />
            <VBox fx:id="extraOperationsPanel" spacing="8.0" />
        </VBox>
    </left>

    <!-- ============ CENTER: display area (tree graphic) ============ -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <Pane fx:id="treeDrawingPanel" styleClass="tree-panel" />
            </content>
        </ScrollPane>
    </center>

    <!-- ============ RIGHT: free panel for info/properties (others can use it) ============ -->
    <right>
        <VBox fx:id="infoPanel" spacing="8.0" prefWidth="220.0" styleClass="side-panel">
            <Label text="Información" styleClass="section-title" />
            <!-- Extension point: property labels, lists, etc. can be added here -->
        </VBox>
    </right>

    <!-- ============ BOTTOM: generic message log ============ -->
    <bottom>
        <VBox spacing="5.0" styleClass="side-panel">
            <Label text="Mensajes" styleClass="section-title" />
            <TextArea fx:id="messagesArea" editable="false" prefHeight="90.0" wrapText="true" />
        </VBox>
    </bottom>

</BorderPane>
