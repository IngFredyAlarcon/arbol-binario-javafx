<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uptc.presentation.controller.CreateTreeController"
            stylesheets="@../css/styles.css"
            prefHeight="200.0" prefWidth="400.0">

    <center>
        <VBox spacing="15.0" alignment="CENTER" styleClass="side-panel">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Crear nuevo árbol" styleClass="section-title" />

            <HBox spacing="10.0" alignment="CENTER">
                <Label text="Nombre del árbol:" />
                <TextField fx:id="treeNameField" promptText="Ej: MiArbol" prefWidth="200.0" />
            </HBox>

            <HBox spacing="10.0" alignment="CENTER">
                <Button fx:id="btnCreate" text="Crear" onAction="#onCreateTree" styleClass="button-primary" />
                <Button fx:id="btnCancel" text="Cancelar" onAction="#onCancel" />
            </HBox>

            <Label fx:id="messageLabel" styleClass="info-message" />
        </VBox>
    </center>

</BorderPane>