<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uptc.presentation.controller.TreeSelectionController">
    <children>
        <Label text="Seleccionar árbol" />
        <ComboBox fx:id="treeSelector" promptText="Elija un árbol" />
        <Button text="Seleccionar" onAction="#selectTree" />
        <Label fx:id="selectedTreeInfoLabel" text="Ningún árbol seleccionado" />
        <Label fx:id="feedbackLabel" text="" />
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>
